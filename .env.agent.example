# Copie este arquivo para .env.agent e preencha com um usuario funcionario ativo.
# O agente usa esse login para gravar as vendas no Firestore com as mesmas regras do app.

AGENT_USER_EMAIL=funcionario@exemplo.com
AGENT_USER_PASSWORD=sua-senha-aqui

# Pasta que o agente vai vigiar.
RECIBOS_WATCH_DIR=C:\Recibos JB

# Origem de venda usada quando o recibo nao informa a origem.
AGENT_ORIGEM_PADRAO=Importacao automatica

# true para ler subpastas tambem.
AGENT_RECURSIVE=false

# Intervalo de varredura em milissegundos.
AGENT_INTERVAL_MS=3000
